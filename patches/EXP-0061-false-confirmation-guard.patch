+class SourceConfirmationAdmission:
+    """Causal admission only: unresolved source evidence is not positive loss.
+
+    Exact measurement witnesses share uncertainty, never raw IDs or inferred
+    identity. Independently measured crossings do not depend on source loss.
+    The original proposed decision remains available in every blocked result.
+    """
+    RULE = 'source_confirmation_admission_v1'
+    CROSSINGS = frozenset(('visible_gate_crossing_v1',
+        'existing_alert_gate_crossing_v1', 'observed_gate_continuation_v1'))
+
+    @staticmethod
+    def key(row):
+        return (row['frame_index'], row.get('cache_index'), row['pts'], tuple(row['bbox']))
+
+    def __init__(self, baseline, events, decisions, scene):
+        self.scene = scene
+        self.policy = Policy(**baseline['policy'])
+        self.segments = {s['id']: s for s in baseline['segments']}
+        self.contexts = []
+        for event in events:
+            source = event['source_event']
+            evidence = source.get('evidence', source)
+            source_at = event.get('decision_time_pts', -1.)
+            validated_at = max((link['validated_at'] for link in evidence.get('reappearance_links', [])
+                                if link['validated_at'] <= source_at), default=-1.)
+            failures = [f for f in evidence.get('provisional_failures', [])
+                        if f['resolved_at'] > validated_at]
+            expired = [f for f in failures if f['reason'] in
+                ('ambiguous_observations_expired', 'measured_chain_expired')]
+            if not expired:
+                continue
+            at = max(event.get('decision_time_pts', -1.),
+                     max(f['resolved_at'] for f in expired))
+            refs = [r for f in failures if f['resolved_at'] <= at
+                    for k in ('observation_refs', 'competing_refs') for r in f.get(k, [])]
+            terminal = evidence.get('source_last_ref')
+            if terminal is None:
+                segment = self.segments.get(source.get('segment'), {})
+                terminal = next((r for r in segment.get('rows', [])
+                    if r['pts'] == source.get('last_observed_pts')), None)
+            if terminal is not None:
+                refs.append(terminal)
+            if refs:
+                self.contexts.append(dict(available_at=at, source_event_id=event['event_id'],
+                    reason='unresolved_source_association_expired', refs=deepcopy(refs)))
+        for decision in decisions:
+            if self.approach_only(decision):
+                refs = self.rows_for(decision)
+                if refs:
+                    self.contexts.append(dict(available_at=decision['decision_time_pts'],
+                        source_event_id=decision['event_id'],
+                        reason='approach_loss_without_outward_direction', refs=[deepcopy(refs[-1])]))
+
+    @staticmethod
+    def approach_only(decision):
+        return (decision.get('rule_id') == 'inside_approach_history_loss_v1'
+            and decision.get('direction', {}).get('direction') != 'outward')
+
+    def rows_for(self, decision, rows=None):
+        if rows is None:
+            rows = decision.get('measured_loss_context')
+        if rows is None:
+            rows = self.segments.get(decision.get('segment'), {}).get('rows', [])
+        last = decision.get('last_observed_pts', decision['decision_time_pts'])
+        rows = [r for r in rows if r['pts'] <= last]
+        if not rows and decision.get('source_last_ref'):
+            rows = [decision['source_last_ref']]
+        return connected_rows(rows, self.scene, self.policy) if rows else []
+
+    def admit(self, decision, rows=None):
+        if not decision.get('automatic_confirmation') or decision.get('rule_id') in self.CROSSINGS:
+            return decision
+        at = decision['decision_time_pts']
+        measured = self.rows_for(decision, rows)
+        keys = {self.key(r) for r in measured}
+        reasons = []
+        if self.approach_only(decision):
+            reasons.append(dict(reason='approach_loss_without_outward_direction',
+                                source_event_id=decision.get('event_id'), matched_refs=[]))
+        for context in self.contexts:
+            if context['available_at'] > at:
+                continue
+            matched = [r for r in context['refs'] if r['pts'] <= at and self.key(r) in keys]
+            if matched:
+                reasons.append(dict(reason=context['reason'],
+                    source_event_id=context['source_event_id'], available_at=context['available_at'],
+                    matched_refs=deepcopy(matched)))
+        if not reasons:
+            return decision
+        result = deepcopy(decision)
+        result.update(status='침입 의심', automatic_confirmation=False, notify=False,
+            reason='source_confirmation_not_admitted',
+            confirmation_admission=dict(rule_id=self.RULE, admitted=False,
+                reasons=reasons, proposed_decision=deepcopy(decision)))
+        return result
