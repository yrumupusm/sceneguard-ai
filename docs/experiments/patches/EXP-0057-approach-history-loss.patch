+def approach_history_loss_decision(previous, segment, scene, frames, policy=Policy()):
+    """Confirm an observed inside approach followed by finite-boundary loss.
+
+    A connected measured pause retains approach. This fallback does not infer a
+    hidden path, identity, or direction from terminal features. Existing feature
+    decisions and the caller's candidate/continuation safeguards remain intact.
+    """
+    result = deepcopy(previous)
+    if (previous.get('automatic_confirmation') or 'inner_line' not in scene
+            or 'inside_to_outside' not in scene['directions']
+            or previous.get('continuation') != 'unresolved'
+            or previous.get('reason') in ('loss_wait_not_observed', 'source_gap_not_person_loss')):
+        return result
+    from .legacy_directional import BoundaryGate, boundary_zone, connected_rows, measured_origin
+    policy.validate()
+    rows = segment['rows']
+    if not rows:
+        return result
+    last = rows[-1]; at = previous['decision_time_pts']
+    if (previous.get('last_observed_pts') != last['pts']
+            or at-last['pts'] < policy.loss_wait-1e-6):
+        return result
+    # Reuse actual admission: missing optional score is permitted, explicit
+    # low-confidence/predicted/unconfirmed observations cannot provide evidence.
+    if any(r.get('observed') is False or r.get('predicted') is True
+           or r.get('confirmed') is False
+           or ('score' in r and r['score'] < EpisodePolicy().detection_floor) for r in rows):
+        return result
+    if any(a['pts'] >= b['pts'] or a['frame_index'] >= b['frame_index']
+           for a,b in zip(rows,rows[1:])):
+        return result
+    rows = connected_rows(rows, scene, policy)
+    clock = [f for f in frames if rows[0]['pts'] <= f['pts'] <= at+1e-9]
+    if (not clock or clock[0]['pts'] != rows[0]['pts'] or abs(clock[-1]['pts']-at) > 1e-6
+            or any(b['pts'] <= a['pts'] or b['frame_index'] != a['frame_index']+1
+                   or b['pts']-a['pts'] > EpisodePolicy().source_gap_seconds+1e-9
+                   for a,b in zip(clock,clock[1:]))):
+        return result
+    actual = {f['frame_index']: f for f in clock}
+    for row in rows:
+        frame = actual.get(row['frame_index'])
+        if frame is None or frame['pts'] != row['pts'] or not any(
+                b.get('cache_index') == row.get('cache_index') and b['bbox'] == row['bbox']
+                and b.get('observed') is not False and b.get('predicted') is not True
+                and b.get('confirmed') is not False
+                and ('score' not in b or b['score'] >= EpisodePolicy().detection_floor)
+                for b in frame['actual_boxes']):
+            return result
+    side, origin = measured_origin(rows, scene, policy)
+    if side != 'inside':
+        return result
+    source = [r for r in rows if r['pts'] >= origin[0]['pts']]
+    if any(boundary_zone(r,scene) == 'outside' for r in source):
+        return result
+    polyline = BoundaryGate(scene, 'inside')
+    selected = polyline.locate(last['bbox'], birth=False)['segment']
+    line = polyline.lines[selected]
+    gate = BoundaryGate(dict(scene, line=list(line)))
+    sites = [gate.locate(r['bbox'], birth=False) for r in source]
+    terminal = sites[-1]
+    if not terminal['near'] or not 0 <= terminal['along'] <= 1:
+        return result
+    # Select a real median origin observation; never synthesize a position.
+    anchor = sorted(origin, key=lambda r: gate.locate(r['bbox'], birth=False)['signed_pixels'])[len(origin)//2]
+    anchor_site = gate.locate(anchor['bbox'], birth=False)
+    if anchor_site['signed_pixels'] <= 0:
+        return result
+    low = anchor_site['signed_pixels']; window = []; approach = None; retreats = []
+    for row, site in zip(source, sites):
+        if row['pts'] <= origin[-1]['pts']:
+            continue
+        window.append((row, site))
+        # Minimal latest measured window meeting BOTH existing stability bounds.
+        while (len(window) > policy.stable_observations
+                and row['pts']-window[1][0]['pts'] >= policy.stable_seconds-1e-9):
+            window.pop(0)
+        if (len(window) < policy.stable_observations
+                or row['pts']-window[0][0]['pts'] < policy.stable_seconds-1e-9):
+            continue
+        if min(s['signed_pixels'] for _,s in window)-low >= policy.min_motion_pixels-1e-9:
+            # Return requires a stable window, and the frontier below also uses
+            # a stable window: a single low outlier cannot fabricate retreat.
+            retreats.append(dict(observations=deepcopy([r for r,_ in window]),
+                                 qualified_at_pts=row['pts']))
+            approach = None
+            anchor, anchor_site = max(window, key=lambda pair: pair[1]['signed_pixels'])
+            low = anchor_site['signed_pixels']; window = []
+            continue
+        stable_frontier = max(s['signed_pixels'] for _,s in window)
+        low = min(low, stable_frontier)
+        eligible = all(0 <= s['along'] <= 1
+                       and anchor_site['signed_pixels']-s['signed_pixels'] >= policy.min_motion_pixels-1e-9
+                       and anchor_site['distance_pixels']-s['distance_pixels'] >= policy.min_motion_pixels-1e-9
+                       for _,s in window)
+        if approach is None and eligible:
+            approach = dict(anchor=deepcopy(anchor), observations=deepcopy([r for r,_ in window]),
+                qualified_at_pts=row['pts'],
+                signed_progress_pixels=min(anchor_site['signed_pixels']-s['signed_pixels'] for _,s in window),
+                finite_distance_progress_pixels=min(anchor_site['distance_pixels']-s['distance_pixels'] for _,s in window))
+    if approach is None:
+        return result
+    result.update(rule_id='inside_approach_history_loss_v1', status='침입 확인',
+        automatic_confirmation=True, notify=True,
+        reason='measured_inside_approach_then_finite_inner_loss',
+        crossing_direction='inside_to_outside', inside_origin=deepcopy(origin),
+        approach_history=approach, measured_retreat_resets=retreats,
+        gate_contact=deepcopy(last), gate_contact_site=terminal, recent_gate_contact=True,
+        source_boundary=deepcopy(scene['inner_line']), source_boundary_segment=selected,
+        measured_boundary_segment=deepcopy(list(line)),
+        boundary_position_formula='bbox_bottom_center',
+        connected_source_first_ref=deepcopy(rows[0]),
+        decision_source='automatic_rule', human_verified=False, identity_verified=False,
+        confirmation_basis='camera_rule_not_manual_or_ground_truth', evidence_until_pts=at)
+    return result
