+++ b/tests/test_approach_history_loss.py
@@ -0,0 +1,91 @@
+"""Actual geometry/causality tests, not accuracy measurements."""
+from copy import deepcopy
+import unittest
+from unittest.mock import patch
+from sceneguard.outward_crossing import approach_history_loss_decision as decide
+from test_legacy_directional import fixture, analyze_fixture, compute, RULE
+
+
+def data(xs=None,pause=0):
+    _,_,scene=fixture()
+    xs=xs if xs is not None else [.70]*3+[.69,.68,.67,.66,.65,.64,.63,.62,.61,.60,.59]+[.59]*pause
+    rows=[];frames=[]
+    for i in range(len(xs)+11):
+        boxes=[]
+        if i<len(xs):
+            box=dict(cache_index=0,bbox=[xs[i]-.025,.4,xs[i]+.025,.6],observed=True)
+            boxes=[deepcopy(box)];rows.append(dict(pts=i/10,frame_index=i,**box))
+        frames.append(dict(pts=i/10,frame_index=i,actual_boxes=boxes,point_paths=[],camera_step_pixels=[0,0]))
+    previous=dict(automatic_confirmation=False,continuation='unresolved',reason='gate_loss_with_outward_or_unclear_direction',direction=dict(direction='unknown',reason='no_target_bound_motion'),last_observed_pts=rows[-1]['pts'],decision_time_pts=rows[-1]['pts']+1.,notify=True,status='침입 의심')
+    return previous,dict(id='source',raw_id=7,rows=rows),scene,frames
+
+class ApproachHistoryTests(unittest.TestCase):
+    def test_approach_stop_loss_long_strip_pause(self):
+        for pause in (0,15,40,80):
+            d=decide(*data(pause=pause));self.assertTrue(d['automatic_confirmation'])
+            self.assertLess(d['approach_history']['qualified_at_pts'],d['last_observed_pts'])
+    def test_never_approached_standing(self):
+        self.assertFalse(decide(*data([.63]*60))['automatic_confirmation'])
+    def test_measured_retreat(self):
+        self.assertFalse(decide(*data([.70]*3+[.68,.66,.64,.62,.60,.60,.60,.62,.64,.64,.64]))['automatic_confirmation'])
+    def test_retreat_then_reapproach(self):
+        d=decide(*data([.70]*3+[.68,.66,.64,.62,.60,.60,.60,.62,.64,.64,.64,.63,.62,.61,.60,.59,.59,.59]))
+        self.assertTrue(d['automatic_confirmation']);self.assertTrue(d['measured_retreat_resets'])
+        self.assertGreater(d['approach_history']['anchor']['pts'],d['inside_origin'][-1]['pts'])
+    def test_single_low_outlier_not_retreat(self):
+        d=decide(*data([.70]*3+[.68,.66,.64,.62,.60,.60,.60,.59,.60,.60,.60]))
+        self.assertTrue(d['automatic_confirmation']);self.assertEqual(d['measured_retreat_resets'],[])
+    def test_single_return_outlier_not_retreat(self):
+        d=decide(*data([.70]*3+[.68,.66,.64,.62,.60,.60,.60,.62,.60,.60,.60]))
+        self.assertTrue(d['automatic_confirmation']);self.assertEqual(d['measured_retreat_resets'],[])
+    def test_single_approach_outlier_not_enough(self):
+        self.assertFalse(decide(*data([.63]*5+[.62]+[.63]*5))['automatic_confirmation'])
+    def test_subthreshold_jitter(self):
+        self.assertFalse(decide(*data([.63]*3+[.629,.631,.629,.630]*5))['automatic_confirmation'])
+    def test_continuation(self):
+        for c in ('same_side_continuation','cross_side_observation'):
+            a=data();a[0]['continuation']=c;self.assertEqual(decide(*a),a[0])
+    def test_no_inside_origin_wrongside_disabled(self):
+        for xs in ([.60]*3+[.59]*5,[.30]*3+[.32,.34,.36,.38,.39]*2):
+            self.assertFalse(decide(*data(xs))['automatic_confirmation'])
+        a=data();del a[2]['inner_line'];self.assertEqual(decide(*a),a[0])
+        a=data();a[2]['directions']=['outside_to_inside'];self.assertEqual(decide(*a),a[0])
+    def test_distant_loss(self):
+        a=data();a[2]['inner_line']=[[.2,.2],[.2,.8]];self.assertFalse(decide(*a)['automatic_confirmation'])
+    def test_jump_gap_same_id(self):
+        a=data();r=a[1]['rows'][-1];r['bbox']=[.58,.5,.60,.6];a[3][r['frame_index']]['actual_boxes'][0]['bbox']=r['bbox'];self.assertFalse(decide(*a)['automatic_confirmation'])
+        a=data();a[1]['rows']=a[1]['rows'][:3]+a[1]['rows'][-2:];self.assertFalse(decide(*a)['automatic_confirmation'])
+    def test_eof_sourcegap_wait(self):
+        a=data();del a[3][-2:];self.assertFalse(decide(*a)['automatic_confirmation'])
+        a=data();a[3].pop(3);self.assertFalse(decide(*a)['automatic_confirmation'])
+        a=data();a[0]['decision_time_pts']-=.1;self.assertFalse(decide(*a)['automatic_confirmation'])
+        for reason in ('loss_wait_not_observed','source_gap_not_person_loss'):
+            a=data();a[0]['reason']=reason;self.assertEqual(decide(*a),a[0])
+    def test_sparse_without_score_and_actual_admission(self):
+        self.assertTrue(decide(*data())['automatic_confirmation'])
+        for flag,value in [('observed',False),('predicted',True),('confirmed',False),('score',.24)]:
+            a=data();a[1]['rows'][3][flag]=value;self.assertFalse(decide(*a)['automatic_confirmation'])
+    def test_finite_endpoint_reversed_line(self):
+        a=data();a[2]['inner_line']=[[.6,.1],[.6,.3]];self.assertFalse(decide(*a)['automatic_confirmation'])
+        a=data();before=decide(*a);a[2]['inner_line'].reverse();after=decide(*a)
+        self.assertEqual(before['approach_history'],after['approach_history'])
+    def test_prefix_causality_actual_refs(self):
+        a=data();original=deepcopy(a);d=decide(*a);self.assertEqual(a,original)
+        a[3].append(dict(pts=9.,frame_index=90,actual_boxes=[]));self.assertEqual(decide(*a),d)
+        for r in d['inside_origin']+d['approach_history']['observations']+[d['approach_history']['anchor'],d['gate_contact']]:
+            self.assertIn(r,a[1]['rows']);self.assertLessEqual(r['pts'],d['last_observed_pts'])
+    def test_all_feature_labels_diagnostic(self):
+        for label in ('unknown','parallel','inward','outward'):
+            a=data();a[0]['direction']['direction']=label;d=decide(*a)
+            self.assertTrue(d['automatic_confirmation']);self.assertEqual(d['direction'],a[0]['direction'])
+    def test_existing_confirmation_exact_preservation(self):
+        a=data();a[0].update(automatic_confirmation=True,rule_id=RULE);self.assertEqual(decide(*a),a[0])
+    def test_original_helper_pipeline_preservation(self):
+        args=fixture();before=compute(deepcopy(args));after=analyze_fixture(args)
+        helper=[d for d in after['seed_decisions'] if d['rule_id']==RULE]
+        with patch('sceneguard.outward_crossing.approach_history_loss_decision',side_effect=lambda previous,*a,**k:deepcopy(previous)):
+            old=analyze_fixture(deepcopy(args))
+        self.assertEqual(helper,[d for d in old['seed_decisions'] if d['rule_id']==RULE]);self.assertTrue(helper)
+        self.assertEqual(compute(deepcopy(args)),before)
+
+if __name__=='__main__':unittest.main()
