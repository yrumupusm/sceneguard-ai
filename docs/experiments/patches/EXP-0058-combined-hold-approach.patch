+def _source_site(row, scene):
+    side = boundary_zone(row, scene)
+    if side == 'inside':
+        return True
+    if side is not None:
+        return False
+    site = BoundaryGate(scene, 'inside').locate(row['bbox'], birth=False)
+    return site['near'] and 0 <= site['along'] <= 1
+
