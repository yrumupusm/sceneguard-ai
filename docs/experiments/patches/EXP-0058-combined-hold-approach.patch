+"""Both-required actual-measurement composition tests; no saved-video replay."""
+from copy import deepcopy
+import unittest
+from unittest.mock import patch
+from test_legacy_directional import fixture
+from test_inner_loss_candidates import generate, analyze
+from test_reappearance_hold import put, prefix
+from sceneguard.legacy_directional import connected_rows, measured_origin
+from sceneguard.outward_crossing import approach_history_loss_decision
+
+
+def case(total=91, last=70):
+    data=fixture(total=total)
+    for f in data[1][21:]: f['actual_boxes']=[]
+    put(data, range(24,last+1), .60)
+    return data
+
+
+def confirmations(data):
+    return [d for d in analyze(data)['seed_decisions'] if d['automatic_confirmation']]
+
+
+class CombinedHoldApproachTests(unittest.TestCase):
+    def test_both_required_original_approach_gap_stationary_loss(self):
+        data=case(); untouched=deepcopy(data)
+        events,sources=generate(data);self.assertEqual(len(events),1)
+        self.assertEqual(events[0]['decision_time_pts'],8.)
+        d=confirmations(data);self.assertEqual(len(d),1);d=d[0]
+        self.assertEqual(d['rule_id'],'inside_approach_history_loss_v1')
+        self.assertEqual(d['direction']['direction'],'unknown')
+        self.assertEqual(d['inside_origin'][0]['pts'],1.)
+        self.assertLessEqual(d['approach_history']['qualified_at_pts'],2.)
+        self.assertEqual(d['last_observed_pts'],7.)
+        self.assertEqual(d['decision_time_pts'],8.)
+        self.assertEqual(measured_origin(sources[0]['rows'],data[2])[0],'inside')
+        self.assertEqual(data,untouched)
+        with patch('sceneguard.outward_crossing.approach_history_loss_decision',side_effect=lambda previous,*a,**k:deepcopy(previous)):
+            self.assertEqual(confirmations(data),[])
+        # Disable0056 validated origin bridge, retaining its observed timing:
+        # the stationary post-gap strip has no independent stable inside origin.
+        with patch('sceneguard.legacy_directional._validated_bridge',return_value=False):
+            self.assertEqual(confirmations(data),[])
+        for r in d['inside_origin']+d['approach_history']['observations']+[d['approach_history']['anchor'],d['gate_contact']]:
+            frame=data[1][r['frame_index']]
+            self.assertEqual(frame['pts'],r['pts'])
+            self.assertTrue(any(b['cache_index']==r['cache_index'] and b['bbox']==r['bbox'] for b in frame['actual_boxes']))
+
+    def test_no_motion_manufactured_across_bridge(self):
+        data=case(last=40)
+        for r in data[0]['segments'][0]['rows']:
+            r['bbox']=[.605,.4,.655,.6]
+            data[1][r['frame_index']]['actual_boxes'][0]['bbox']=deepcopy(r['bbox'])
+        self.assertTrue(generate(data)[0]);self.assertEqual(confirmations(data),[])
+
+    def test_new_contiguous_approach_after_bridge_can_qualify(self):
+        data=case(last=40)
+        for r in data[0]['segments'][0]['rows']:
+            r['bbox']=[.625,.4,.675,.6]
+            data[1][r['frame_index']]['actual_boxes'][0]['bbox']=deepcopy(r['bbox'])
+        for f in data[1][24:41]:
+            x=max(.59,.63-(f['frame_index']-24)*.005)
+            f['actual_boxes'][0]['bbox']=[x-.025,.4,x+.025,.6]
+        d=confirmations(data);self.assertEqual(len(d),1)
+        self.assertGreaterEqual(d[0]['approach_history']['anchor']['pts'],2.4)
+        self.assertEqual(d[0]['inside_origin'][0]['pts'],1.)
+
+    def test_singleton_does_not_refresh_clock(self):
+        data=case(last=24);d=confirmations(data)
+        self.assertEqual(len(d),1);self.assertEqual(d[0]['last_observed_pts'],2.)
+        self.assertEqual(d[0]['decision_time_pts'],3.)
+
+    def test_continuing_presence_and_eof_do_not_confirm(self):
+        self.assertEqual(confirmations(case(total=71,last=70)),[])
+        self.assertEqual(generate(case(total=71,last=70)),([],[]))
+
+    def test_stable_retreat_after_bridge_cancels_approach(self):
+        data=case(last=40)
+        for f in data[1][32:41]:
+            f['actual_boxes'][0]['bbox']=[.615,.4,.665,.6]
+        self.assertEqual(confirmations(data),[])
+
+    def test_no_origin_means_no_derived_bridge(self):
+        data=case(last=40)
+        for r in data[0]['segments'][0]['rows']:
+            r['bbox']=[.575,.4,.625,.6]
+            data[1][r['frame_index']]['actual_boxes'][0]['bbox']=deepcopy(r['bbox'])
+        self.assertEqual(generate(data),([],[]));self.assertEqual(confirmations(data),[])
+
+    def test_source_gap_is_not_loss(self):
+        data=case(last=40)
+        for f in data[1][45:]:
+            f['pts']+=.3; f['native_pts']+=3
+        self.assertEqual(confirmations(data),[])
+
+    def test_prefix_causality_and_future_return(self):
+        data=case(last=40);full=analyze(data)
+        for index in (23,24,25,26,40,49,50,60):
+            d=analyze(prefix(data,index))
+            self.assertEqual(d['seed_decisions'],[r for r in full['seed_decisions'] if r['decision_time_pts']<=index/10])
+        put(data,range(65,71),.60)
+        self.assertEqual(analyze(data)['seed_decisions'],full['seed_decisions'])
+
+    def test_bridge_witness_tampering_and_future_validation_rejected(self):
+        data=case(last=40);_,sources=generate(data)
+        rows=sources[0]['rows'];bridge=next(r for r in rows if 'source_reappearance_link' in r)
+        self.assertEqual(len(connected_rows(rows,data[2])),len(rows))
+        self.assertIsNone(measured_origin([r for r in rows if r['pts']<2.6],data[2])[0])
+        for key,value in [('validated_at',99.),('origin_refs',[]),('observation_refs',[])]:
+            altered=deepcopy(rows);next(r for r in altered if 'source_reappearance_link' in r)['source_reappearance_link'][key]=value
+            self.assertIsNone(measured_origin(altered,data[2])[0])
+
+if __name__=='__main__':unittest.main()
