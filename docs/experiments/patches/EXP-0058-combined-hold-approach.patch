+def _source_pieces(baseline, frames, scene, actual, policy):
+    """Prepare only inside-source context; other branches keep original pieces."""
+    by_ref = {(r['frame_index'], r['cache_index']): r for r in actual}
+    by_frame = {}
+    for row in actual:
+        by_frame.setdefault(row['frame_index'], []).append(row)
+    consumed = set()
+    for segment_index, segment in enumerate(baseline['segments']):
+        pieces = []
+        for row in segment['rows']:
+            if not pieces or len(connected_rows([pieces[-1][-1], row], scene, policy)) == 1:
+                pieces.append([])
+            pieces[-1].append(row)
+        for rows in pieces:
+            if not rows or any((r['frame_index'], r.get('cache_index')) not in by_ref
+                    or _measurement_ref(by_ref[(r['frame_index'], r['cache_index'])]) != _measurement_ref(r)
+                    or r.get('observed') is False or r.get('predicted') is True
+                    or r.get('confirmed') is False for r in rows):
+                continue
+            prepared = dict(rows=rows)
+            if ('inner_line' in scene and 'inside_to_outside' in scene['directions']
+                    and measured_origin(rows, scene, policy)[0] == 'inside'):
+                if (rows[0]['frame_index'], rows[0]['cache_index']) in consumed:
+                    continue
+                prepared = _inside_reappearance(rows, frames, by_frame, scene, policy)
+                if prepared is None:
+                    continue
+                consumed.update((r['frame_index'], r['cache_index']) for r in prepared['rows'])
+            yield dict(segment, **prepared, original_segment_index=segment_index,
+                       original_terminal_ref=deepcopy(rows[-1]))
+
