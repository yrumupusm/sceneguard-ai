+"""Synthetic source-context counterexamples; no saved-video replay or identity truth."""
+from copy import deepcopy
+import unittest
+
+from sceneguard.legacy_directional import (connected_rows, measured_origin,
+    loss_appearance_candidates, REAPPEARANCE_RULE, DirectionalGate)
+from test_legacy_directional import fixture, SCOPE
+from test_inner_loss_candidates import generate, analyze
+
+
+def put(data, indices, x=.63, *, cache=8, score=.9, bbox=None, tracked=False):
+    baseline, frames, _ = data
+    for i in indices:
+        box = dict(cache_index=cache, score=score, observed=True,
+                   bbox=deepcopy(bbox or [x-.025,.4,x+.025,.6]), track_ids=[7])
+        frames[i]['actual_boxes'].append(box)
+        if tracked:
+            baseline['segments'][0]['rows'].append(dict(pts=frames[i]['pts'], frame_index=i, **deepcopy(box)))
+    return data
+
+
+def prefix(data, index):
+    b, fs, s = deepcopy(data)
+    for segment in b['segments']:
+        segment['rows'] = [r for r in segment['rows'] if r['frame_index'] <= index]
+    return b, fs[:index+1], s
+
+
+class ReappearanceHoldTests(unittest.TestCase):
+    def test_one_and_two_transient_orange_rows_cannot_veto(self):
+        for indices in ([26], [26,27]):
+            data = put(fixture(), indices, score=.251)
+            events, sources = generate(data)
+            self.assertEqual(len(events), 1)
+            self.assertEqual(events[0]['decision_time_pts'], 3.)
+            self.assertEqual(sources[0]['rows'][-1]['pts'], 2.)
+            self.assertEqual(events[0]['source_event']['provisional_failures'][-1]['reason'],
+                             'measured_chain_expired')
+
+    def test_sustained_continuation_refreshes_actual_loss_clock(self):
+        data = put(fixture(total=51), range(23,32))
+        events, sources = generate(data)
+        self.assertEqual([e['decision_time_pts'] for e in events], [4.1])
+        raw = events[0]['source_event']
+        self.assertEqual(raw['last_observed_pts'], 3.1)
+        self.assertEqual(raw['reappearance_links'][0]['validated_at'], 2.5)
+        self.assertEqual(raw['reappearance_links'][0]['anchor_ref']['pts'], 2.)
+        self.assertEqual(raw['original_source_ref']['last_ref']['pts'], 2.)
+        self.assertEqual(raw['original_source_ref']['continuation_last_ref']['pts'], 3.1)
+        self.assertEqual(raw['source_origin_refs'][0]['pts'], 1.)
+        self.assertEqual(sources[0]['rows'][-1]['pts'], 3.1)
+        self.assertEqual(generate(prefix(data, 32)), ([], []))
+
+    def test_corridor_two_bridges_preserve_origin_and_measured_approach(self):
+        data = fixture(total=51)
+        put(data, range(23,28), .59, tracked=True)
+        put(data, range(31,35), .57, tracked=True)
+        events, sources = generate(data)
+        self.assertEqual(len(events), 1)
+        self.assertEqual(events[0]['decision_time_pts'], 4.4)
+        links = events[0]['source_event']['reappearance_links']
+        self.assertEqual([x['validated_at'] for x in links], [2.5, 3.3])
+        self.assertEqual([x['anchor_ref']['pts'] for x in links], [2., 2.7])
+        self.assertEqual(measured_origin(sources[0]['rows'], data[2])[0], 'inside')
+        self.assertEqual([r['pts'] for r in sources[0]['rows']],
+                         [r['pts'] for r in data[0]['segments'][0]['rows']])
+        # Raw observations still split: only the derived witnessed context joins.
+        self.assertIsNone(measured_origin(data[0]['segments'][0]['rows'], data[2])[0])
+        self.assertEqual(DirectionalGate(data[1], data[2]).direction(sources[0])['source_origin_side'], 'inside')
+        # EXP0058 preserves the qualified bridge and now confirms its measured
+        # pre-gap approach through the independent EXP0057 fallback.
+        confirmed = [d for d in analyze(data)['seed_decisions'] if d['automatic_confirmation']]
+        self.assertEqual(len(confirmed), 1)
+        self.assertEqual(confirmed[0]['rule_id'], 'inside_approach_history_loss_v1')
+        self.assertEqual(confirmed[0]['inside_origin'][0]['pts'], 1.)
+        self.assertEqual(confirmed[0]['decision_time_pts'], 4.4)
+
+    def test_pending_at_deadline_holds_until_first_qualified_frame(self):
+        data = put(fixture(total=51), [29,30,31])
+        self.assertEqual(generate(prefix(data,30)), ([], []))
+        events, _ = generate(data)
+        self.assertEqual(events[0]['decision_time_pts'], 4.1)
+        self.assertEqual(events[0]['source_event']['reappearance_links'][0]['validated_at'], 3.1)
+
+    def test_failed_deadline_pending_emits_at_first_observed_expiry(self):
+        data = put(fixture(total=51), [29,30])
+        self.assertEqual(generate(prefix(data,32)), ([], []))
+        events, _ = generate(data)
+        self.assertEqual(events[0]['decision_time_pts'], 3.3)
+        self.assertEqual(events[0]['source_event']['provisional_failures'][-1]['resolved_at'], 3.3)
+        self.assertEqual(events[0]['source_event']['last_observed_pts'], 2.)
+
+    def test_first_future_validation_cannot_rewrite_any_prefix(self):
+        for indices in ([29,30], [29,30,31], [31,32,33]):
+            data = put(fixture(total=51), indices, tracked=True)
+            events, _ = generate(data)
+            for index in range(20,51):
+                with self.subTest(indices=indices,index=index):
+                    actual, _ = generate(prefix(data,index))
+                    self.assertEqual(actual, [e for e in events if e['decision_time_pts'] <= index/10])
+
+    def test_pipeline_prefix_notifications_and_confirmations(self):
+        data = put(fixture(total=51), [29,30])
+        full = analyze(data)
+        for index in (30,32,33,40):
+            result = analyze(prefix(data,index))
+            self.assertEqual(result['seed_decisions'], [d for d in full['seed_decisions']
+                                                      if d['decision_time_pts'] <= index/10])
+            for key in ('timeline', 'notification_intents'):
+                self.assertEqual(result['cards'][key], [r for r in full['cards'][key]
+                                                       if r['decision_time_pts'] <= index/10])
+
+    def test_eof_and_source_clock_gap_are_not_failure_evidence(self):
+        data = put(fixture(total=33), [29,30])
+        self.assertEqual(generate(data), ([], []))
+        data = put(fixture(total=51), [29,30])
+        for frame in data[1][32:]:frame['pts'] += .3
+        self.assertEqual(generate(data), ([], []))
+
+    def test_same_id_does_not_bridge_size_jump_position_jump_or_wrong_side(self):
+        for case in ('size', 'position', 'wrong_side'):
+            data = fixture(total=51)
+            if case == 'size':
+                put(data, [23,24,25], bbox=[.58,.2,.68,.6], tracked=True)
+            elif case == 'position':
+                put(data, [23,24,25], .9, tracked=True)
+            else:
+                data[2]['zones']['outside'] = [[.05,.1],[.60,.1],[.60,.95],[.05,.95]]
+                put(data, [23,24,25], .59, tracked=True)
+            events, _ = generate(data)
+            first = next(e for e in events if e['source_event']['original_source_ref']['first_ref']['pts'] == 1.)
+            self.assertEqual(first['source_event']['last_observed_pts'], 2.)
+            self.assertNotIn('reappearance_links', first['source_event'])
+
+    def test_stable_observations_duration_and_step_are_separate(self):
+        cases = ([21,22], [21,24,27], [21,24])
+        for indices in cases:
+            data = put(fixture(total=51), indices)
+            events, _ = generate(data)
+            self.assertEqual(events[0]['source_event']['last_observed_pts'], 2.)
+
+    def test_subthreshold_boxes_do_not_hold_but_floor_is_inclusive(self):
+        for score, last in ((.249,2.), (.25,2.5)):
+            data = put(fixture(total=51), [23,24,25], score=score)
+            self.assertEqual(generate(data)[0][0]['source_event']['last_observed_pts'], last)
+
+    def test_no_aspect_ratio_filter(self):
+        data = fixture(total=51)
+        for row in data[0]['segments'][0]['rows']:
+            x=(row['bbox'][0]+row['bbox'][2])/2
+            row['bbox']=[x-.2,.4,x+.2,.6]
+            data[1][row['frame_index']]['actual_boxes'][0]['bbox']=deepcopy(row['bbox'])
+        put(data,[23,24,25],bbox=[.43,.4,.83,.6])
+        self.assertEqual(generate(data)[0][0]['source_event']['last_observed_pts'],2.5)
+
+    def test_competing_boxes_hold_without_pooling_or_id_selection(self):
+        data = fixture(total=51)
+        put(data,[29,30],cache=8);put(data,[29,30],cache=9)
+        self.assertEqual(generate(prefix(data,32)), ([], []))
+        events, _ = generate(data)
+        self.assertEqual(events[0]['decision_time_pts'],3.3)
+        self.assertEqual(events[0]['source_event']['last_observed_pts'],2.)
+        self.assertFalse(events[0]['source_event']['reappearance_links'])
+
+    def test_derived_witness_requires_validation_prefix_and_exact_refs(self):
+        data = put(fixture(total=51), [23,24,25], .59)
+        rows = generate(data)[1][0]['rows']
+        self.assertEqual(measured_origin(rows,data[2])[0],'inside')
+        self.assertIsNone(measured_origin(rows[:-1],data[2])[0])
+        for field in ('validated_at','anchor_ref','observation_refs','origin_refs','rule_id'):
+            bad = deepcopy(rows)
+            del bad[11]['source_reappearance_link'][field]
+            self.assertIsNone(measured_origin(bad,data[2])[0])
+        bad = deepcopy(rows);bad[-1]['bbox'][0] += .001
+        self.assertIsNone(measured_origin(bad,data[2])[0])
+
+    def test_sparse_saved_source_uses_checked_actual_admission_without_enrichment(self):
+        data=fixture(total=51)
+        for row in data[0]['segments'][0]['rows']:
+            for key in ('score','observed','track_ids'):row.pop(key,None)
+        before=deepcopy(data[0]['segments'][0]['rows'])
+        put(data,[23,24,25],.59)
+        events,sources=generate(data)
+        self.assertEqual(events[0]['source_event']['last_observed_pts'],2.5)
+        self.assertEqual(sources[0]['rows'][:len(before)],before)
+        self.assertEqual(measured_origin(sources[0]['rows'],data[2])[0],'inside')
+        self.assertNotIn('score',sources[0]['rows'][0])
+        self.assertGreaterEqual(events[0]['source_event']['reappearance_links'][0]
+                                ['origin_actual_refs'][0]['score'],.25)
+
+    def test_helper_later_birth_obeys_qualified_return_without_revising_old_loss(self):
+        for indices,expected,at in (([35,36,37],0,None),([44,45],1,4.8),([44,45,46],0,None)):
+            data=fixture(total=61)
+            birth=deepcopy(data[1][25]['actual_boxes'][0])
+            for frame in data[1][25:30]:frame['actual_boxes']=[]
+            data[1][45]['actual_boxes'].append(birth)
+            put(data,indices)
+            old=generate(data)[0][0]
+            self.assertEqual(old['decision_time_pts'],3.)
+            events,_=loss_appearance_candidates(*data,SCOPE,'run')
+            self.assertEqual(len(events),expected)
+            if expected:
+                self.assertEqual(events[0]['decision_time_pts'],at)
+            for index in range(30,61):
+                short,_=loss_appearance_candidates(*prefix(data,index),SCOPE,'run')
+                self.assertEqual(short,[e for e in events if e['decision_time_pts']<=index/10])
+
+    def test_helper_keeps_recent_start_side_even_with_retained_origin(self):
+        data = put(fixture(total=61), [23,24,25,26], .59)
+        birth = deepcopy(data[1][25]['actual_boxes'][0])
+        for f in data[1][25:30]:f['actual_boxes'] = [b for b in f['actual_boxes'] if b['cache_index'] != 1]
+        data[1][40]['actual_boxes'].append(birth)
+        self.assertEqual(loss_appearance_candidates(*data,SCOPE,'run'),([],[]))
+
+    def test_013_shaped_no_return_keeps_old_65_566667_helper_clock(self):
+        # Synthetic clock/provenance regression, not a replay of video 013.
+        data=fixture(total=71);b,fs,s=data
+        birth=deepcopy(fs[25]['actual_boxes'][0])
+        for f in fs[25:30]:f['actual_boxes']=[]
+        fs[48]['actual_boxes'].append(birth)
+        offset=60.766666666666666
+        for f in fs:f['pts'] += offset
+        for r in b['segments'][0]['rows']:r['pts'] += offset
+        events, decisions=loss_appearance_candidates(*data,SCOPE,'run')
+        self.assertEqual(len(events),1)
+        self.assertAlmostEqual(decisions[0]['decision_time_pts'],65.56666666666666)
+        self.assertEqual(decisions[0]['source_origin_refs'][0]['pts'],61.766666666666666)
+        self.assertNotIn('reappearance_links',decisions[0])
+
+    def test_outside_single_hit_veto_and_no_inner_branch_unchanged(self):
