+def _box_step(a, b, scene, policy):
+    """Existing position/scale bounds, without assuming a time interval."""
+    ah, bh = a['bbox'][3]-a['bbox'][1], b['bbox'][3]-b['bbox'][1]
+    aw, bw = a['bbox'][2]-a['bbox'][0], b['bbox'][2]-b['bbox'][0]
+    return (b['pts'] > a['pts'] and b['frame_index'] > a['frame_index']
+        and min(ah, bh, aw, bw) > 0
+        and max(ah/bh, bh/ah, aw/bw, bw/aw) <= policy.scale_jump
+        and math.dist(center(a, scene['source_size']), center(b, scene['source_size']))
+        <= .5*max(ah, bh)*scene['source_size'][1])
+
