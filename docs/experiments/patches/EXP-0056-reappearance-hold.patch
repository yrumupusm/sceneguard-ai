+def _inside_reappearance(rows, frames, actual_by_frame, scene, policy):
+    """Resolve the first loss causally; EOF is not a failed provisional chain.
+
+    A new chain must start by the current 1 s deadline. It may finish qualifying
+    after that deadline, but expires only on an observed clock beyond .25 s
+    since its last measurement. Once qualified, actual contiguous observations
+    refresh the loss clock; the next gap requires a fresh qualification.
+    """
+    rows = deepcopy(rows)
+    origin, support = measured_origin(rows, scene, policy)
+    if origin != 'inside':
+        return None
+    pending = []; links = []; failures = []; following = False
+    ambiguous_at = None
+    start = rows[-1]['frame_index']+1
+    for frame in frames[start:]:
+        at = frame['pts']; last = rows[-1]
+        previous = frames[frame['frame_index']-1]
+        if at-previous['pts'] > EpisodePolicy().source_gap_seconds+1e-9:
+            return None
+        if pending and at-pending[-1]['pts'] > policy.max_direction_step+1e-9:
+            failures.append(dict(observation_refs=[_measurement_ref(r) for r in pending],
+                resolved_at=at, reason='measured_chain_expired'))
+            pending = []
+        if ambiguous_at is not None and at-ambiguous_at > policy.max_direction_step+1e-9:
+            failures.append(dict(resolved_at=at, reason='ambiguous_observations_expired',
+                                 last_ambiguous_at=ambiguous_at))
+            ambiguous_at = None
+        # Failure discovered after the deadline emits now, never backdated.
+        if at > last['pts']+policy.loss_wait+1e-9 and not pending and ambiguous_at is None:
+            return dict(rows=rows, loss_ready_at=at, reappearance_links=links,
+                        provisional_failures=failures)
+        anchor = pending[-1] if pending else last
+        matches = [r for r in actual_by_frame.get(frame['frame_index'], [])
+                   if _source_site(r, scene) and _corresponds(anchor, r, scene, policy)]
+        if len(matches) > 1:
+            failures.append(dict(observation_refs=[_measurement_ref(r) for r in pending],
+                competing_refs=[_measurement_ref(r) for r in matches], resolved_at=at,
+                reason='ambiguous_geometric_correspondence'))
+            pending = []; following = False; ambiguous_at = at
+        elif matches:
+            row = matches[0]
+            if ambiguous_at is not None and at > last['pts']+policy.loss_wait+1e-9:
+                # Continuing ambiguous presence may hold, but cannot start a
+                # new bridge outside the already fixed reacquisition window.
+                ambiguous_at = at
+            elif following and at-last['pts'] <= policy.max_direction_step+1e-9:
+                rows.append(deepcopy(row))
+            else:
+                ambiguous_at = None
+                pending.append(row); following = False
+                if (len(pending) >= policy.stable_observations
+                        and at-pending[0]['pts'] >= policy.stable_seconds-1e-9):
+                    link = dict(rule_id=REAPPEARANCE_RULE, anchor_ref=_measurement_ref(last),
+                        origin_refs=[_measurement_ref(r) for r in support],
+                        origin_actual_refs=[deepcopy(next(a for a in actual_by_frame[r['frame_index']]
+                            if _measurement_ref(a) == _measurement_ref(r))) for r in support],
+                        observation_refs=[_measurement_ref(r) for r in pending], validated_at=at)
+                    accepted = deepcopy(pending)
+                    accepted[0]['source_reappearance_link'] = deepcopy(link)
+                    rows.extend(accepted); links.append(link)
+                    pending = []; following = True
+        elif following and at-last['pts'] > policy.max_direction_step+1e-9:
+            following = False
+        if at >= rows[-1]['pts']+policy.loss_wait-1e-9 and not pending and ambiguous_at is None:
+            return dict(rows=rows, loss_ready_at=at, reappearance_links=links,
+                        provisional_failures=failures)
+    return None
