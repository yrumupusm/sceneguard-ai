+def _qualified_same_side_return(last, frames, actual, scene, policy, decision_at):
+    """Guard a later helper decision without revising an earlier loss event.
+
+    A return after the bridge window cannot inherit origin, but a qualified
+    same-side return before a later destination birth still refutes that pair.
+    An unresolved return at its proposed decision holds that decision only.
+    """
+    by_frame = {}
+    for row in actual:
+        if row['pts'] > last['pts']:
+            by_frame.setdefault(row['frame_index'], []).append(row)
+    chain = []; ambiguous_at = None
+    for frame in frames[last['frame_index']+1:]:
+        at = frame['pts']
+        if at-frames[frame['frame_index']-1]['pts'] > EpisodePolicy().source_gap_seconds+1e-9:
+            return None
+        if chain and at-chain[-1]['pts'] > policy.max_direction_step+1e-9:
+            chain = []
+        if ambiguous_at is not None and at-ambiguous_at > policy.max_direction_step+1e-9:
+            ambiguous_at = None
+        # Resolve an expired hold before considering a new post-decision chain.
+        if at > decision_at+1e-9 and not chain and ambiguous_at is None:
+            return at
+        anchor = chain[-1] if chain else last
+        matches = [r for r in by_frame.get(frame['frame_index'], [])
+            if boundary_zone(r, scene) == 'inside'
+            and association(r['bbox'], last['bbox'], EpisodePolicy().association_overlap) is not None
+            and _corresponds(anchor, r, scene, policy)]
+        if len(matches) > 1:
+            chain = []; ambiguous_at = at
+        elif matches:
+            chain.append(matches[0]); ambiguous_at = None
+            if (len(chain) >= policy.stable_observations
+                    and at-chain[0]['pts'] >= policy.stable_seconds-1e-9):
+                return None
+        if at >= decision_at-1e-9 and not chain and ambiguous_at is None:
+            return at
+    return None
